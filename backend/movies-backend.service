[Unit]
Description=Movies App FastAPI Backend
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/app
Environment="S3_UPLOAD_BUCKET=movies-app-upload-raw-videos"
Environment="AWS_REGION=us-east-1"
Environment="CLOUDFRONT_DOMAIN=YOUR_CLOUDFRONT_DOMAIN"
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
